<Project>

  <!-- ============================================================
       BT.601 全范围系数着色器注入（共享 · 跨平台）
       被含内嵌 YUV→RGB 着色器字符串的工程显式 Import
       （Renderers.D3D11 / Renderers.OpenGL / Renderers.OpenGLES / Renderers.Metal）。

       系数唯一真源：Targets/Colorimetry/Bt601FullRange.props（本目录）。
       C# CPU 路径真源为 Abstractions/Bt601FullRange.cs——两处数值须一致，
       由 CheckBt601Consistency 内联任务在构建期强制校验（不一致即构建失败）。

       注入方式：扫描工程源码中含 BT.601 字面量（1.402 与 0.344136 特征对）的
       raw string 常量（const string Xxx = """...""";），把字面量替换为 props
       真源值，生成 $(IntermediateOutputPath)Bt601Shaders.g.cs
       （internal static class Bt601Shaders，命名空间 = $(RootNamespace)）。
       消费工程把原 const string 改为 static string Xxx => Bt601Shaders.Xxx;
       （源文件保留原 raw string 作可读模板，构建期以生成常量为准）。

       注意：源文件中的原常量与生成常量同名同类会冲突——消费工程的转换写法是
       删除原 const 定义、仅留属性转发；本任务扫描的是「仍含字面量的 raw string」，
       因此转换必须保留一份含字面量的模板源。落点约定：模板常量改名为
       XxxTemplate（private const string），转发属性 Xxx 引用生成常量。

       进程内执行（netstandard2.0 基线 BCL），零宿主专属依赖；
       生成文件编译进程序集，不进 NuGet 包，下游零重跑。
       增量：仅当本 targets / props / 消费工程 .cs 变化时重新生成。
       ============================================================ -->

  <Import Project="$(MSBuildThisFileDirectory)Bt601FullRange.props" />

  <UsingTask TaskName="GenerateBt601ShaderSources" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ProjectDir ParameterType="System.String" Required="true" />
      <OutputFile ParameterType="System.String" Required="true" />
      <RootNamespace ParameterType="System.String" Required="true" />
      <Rv ParameterType="System.String" Required="true" />
      <Gu ParameterType="System.String" Required="true" />
      <Gv ParameterType="System.String" Required="true" />
      <Bu ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
// 扫描 XxxTemplate raw string 常量（含 1.402 与 0.344136 特征对），
// 字面量替换为 props 真源值后输出 Bt601Shaders.Xxx（去掉 Template 后缀）。
var files = Directory.GetFiles(ProjectDir, "*.cs", SearchOption.AllDirectories);
var sb = new StringBuilder();
sb.AppendLine("// <auto-generated>");
sb.AppendLine("// Generated by GenerateBt601ShaderSources from Targets/Colorimetry/Bt601FullRange.props. Do not edit.");
sb.AppendLine("// BT.601 full-range coefficients single source; C# CPU counterpart: Abstractions/Bt601FullRange.cs.");
sb.AppendLine("// </auto-generated>");
sb.AppendLine("namespace " + RootNamespace + ";");
sb.AppendLine();
sb.AppendLine("internal static class Bt601Shaders");
sb.AppendLine("{");

var constRx = new Regex("(?<name>\\w+)Template\\s*=\\s*\"\"\"(?<body>.*?)\"\"\";", RegexOptions.Singleline);
var seen = new HashSet<string>(StringComparer.Ordinal);
int count = 0;
foreach (var file in files)
{
    if (file.EndsWith(".g.cs", StringComparison.OrdinalIgnoreCase)) continue;
    var text = File.ReadAllText(file);
    if (!text.Contains("1.402") || !text.Contains("0.344136")) continue;
    foreach (Match m in constRx.Matches(text))
    {
        var body = m.Groups["body"].Value;
        if (!body.Contains("1.402") || !body.Contains("0.344136")) continue;
        var name = m.Groups["name"].Value;
        if (!seen.Add(name))
        {
            throw new InvalidOperationException("Duplicate BT.601 shader template name '" + name + "Template' across project; rename one before build.");
        }
        // 字面量 → 真源值（0.5019608 = 128/255 色度中心，数学常量不属 props 域，保持原样）
        var replaced = body
            .Replace("0.344136", Gu)
            .Replace("0.714136", Gv)
            .Replace("1.402", Rv)
            .Replace("1.772", Bu);
        sb.AppendLine("    /// <summary>BT.601 注入后的着色器源（模板 " + name + "Template，来自 " + Path.GetFileName(file) + "）。</summary>");
        sb.AppendLine("    internal const string " + name + " = \"\"\"" + replaced + "\"\"\";");
        sb.AppendLine();
        count++;
    }
}
sb.AppendLine("}");
if (count == 0)
{
    throw new InvalidOperationException("No BT.601 shader templates (*Template raw strings) found in " + ProjectDir + "; remove the Bt601ShaderSources.targets Import from this project.");
}
var fullOutput = Path.GetFullPath(OutputFile);
Directory.CreateDirectory(Path.GetDirectoryName(fullOutput));
File.WriteAllText(fullOutput, sb.ToString(), new UTF8Encoding(false));
Log.LogMessage(Microsoft.Build.Framework.MessageImportance.Low, "[GEN-BT601] Generated {0} ({1} shader constant(s))", fullOutput, count);
]]></Code>
    </Task>
  </UsingTask>

  <UsingTask TaskName="CheckBt601Consistency" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <AbstractionsFile ParameterType="System.String" Required="true" />
      <GlslFile ParameterType="System.String" Required="true" />
      <Rv ParameterType="System.String" Required="true" />
      <Gu ParameterType="System.String" Required="true" />
      <Gv ParameterType="System.String" Required="true" />
      <Bu ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
// 构建期一致性门禁：C# CPU 真源（Bt601FullRange.cs）与 shader props 真源数值必须一致。
var text = File.ReadAllText(AbstractionsFile);
var pairs = new[] { ("Rv", Rv), ("Gu", Gu), ("Gv", Gv), ("Bu", Bu) };
foreach (var (name, expected) in pairs)
{
    var m = Regex.Match(text, "public const double " + name + " = ([0-9.]+);");
    if (!m.Success)
    {
        throw new InvalidOperationException("Bt601FullRange.cs missing const " + name + "; consistency gate cannot run.");
    }
    var actual = double.Parse(m.Groups[1].Value, System.Globalization.CultureInfo.InvariantCulture);
    var want = double.Parse(expected, System.Globalization.CultureInfo.InvariantCulture);
    if (Math.Abs(actual - want) > 1e-9)
    {
        throw new InvalidOperationException("BT.601 coefficient drift: Bt601FullRange.cs " + name + "=" + actual +
            " vs Targets/Colorimetry/Bt601FullRange.props " + expected + ". Update both to the same value.");
    }
}
// Vulkan GLSL 源（预编译 SPIR-V 路径，不走字符串注入）：字面量也须与 props 一致。
var glsl = File.ReadAllText(GlslFile);
foreach (var (name, expected) in pairs)
{
    if (!glsl.Contains(expected))
    {
        throw new InvalidOperationException("BT.601 coefficient drift: Targets/Vulkan/Shaders/yuv.frag missing literal " +
            expected + " (" + name + "). Update yuv.frag to match Bt601FullRange.props and recompile .spv via glslang.");
    }
}
Log.LogMessage(Microsoft.Build.Framework.MessageImportance.Low, "[BT601-CHECK] CPU/shader/GLSL coefficient sources consistent.");
]]></Code>
    </Task>
  </UsingTask>

  <Target Name="GenerateBt601ShaderByteArrays" BeforeTargets="CoreCompile"
          Inputs="$(MSBuildThisFileFullPath);$(MSBuildThisFileDirectory)Bt601FullRange.props;$(MSBuildThisFileDirectory)..\Vulkan\Shaders\yuv.frag;@(Compile)"
          Outputs="$(IntermediateOutputPath)Bt601Shaders.g.cs">
    <CheckBt601Consistency AbstractionsFile="$(MSBuildThisFileDirectory)..\..\src\Infrastructure\LingFan.Media.Abstractions\Models\Frames\Bt601FullRange.cs"
                           GlslFile="$(MSBuildThisFileDirectory)..\Vulkan\Shaders\yuv.frag"
                           Rv="$(Bt601Rv)" Gu="$(Bt601Gu)" Gv="$(Bt601Gv)" Bu="$(Bt601Bu)" />
    <GenerateBt601ShaderSources ProjectDir="$(MSBuildProjectDirectory)" OutputFile="$(IntermediateOutputPath)Bt601Shaders.g.cs"
                                RootNamespace="$(RootNamespace)" Rv="$(Bt601Rv)" Gu="$(Bt601Gu)" Gv="$(Bt601Gv)" Bu="$(Bt601Bu)" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)Bt601Shaders.g.cs" />
      <FileWrites Include="$(IntermediateOutputPath)Bt601Shaders.g.cs" />
    </ItemGroup>
  </Target>

</Project>