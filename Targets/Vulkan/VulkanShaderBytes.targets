<Project>

  <!-- ============================================================
       Vulkan 着色器字节生成（共享 · 跨平台）
       被含 Vulkan 着色器的工程显式 Import（GPUShare.Vulkan / Renderers.Vulkan）。

       着色器唯一真源：Targets/Vulkan/Shaders/（GLSL 源 + 预编译 SPIR-V）。
       各导入工程由同一目录映射生成自己的 Shaders.g.cs（internal static
       EmbeddedShaders，命名空间 = 该工程的 $(RootNamespace)）——消费代码不改。

       模块映射：工程可设 VulkanShaderModules（分号分隔的模块名，不含 .spv，
       如 "yuv.vert;yuv.frag"）；留空 = 嵌入共享目录全部模块。

       生成经 RoslynCodeTaskFactory 内联任务在 MSBuild 进程内执行，
       Windows / Linux / macOS 均可构建，不依赖 PowerShell 等宿主组件。

       打包不变：shader 文件不进 NuGet 包；生成的 Shaders.g.cs 编译进
       程序集（随 DLL 分发），下游消费者无需重跑任何工具。

       增量：仅当共享目录内 .spv/.vert/.frag 变化时才重新生成。
       ============================================================ -->

  <PropertyGroup>
    <_VulkanShaderDir>$(MSBuildThisFileDirectory)Shaders</_VulkanShaderDir>
  </PropertyGroup>

  <ItemGroup>
    <_VulkanShaderSource Include="$(_VulkanShaderDir)\*.spv;$(_VulkanShaderDir)\*.vert;$(_VulkanShaderDir)\*.frag" />
  </ItemGroup>

  <UsingTask TaskName="GenerateVulkanShaderBytes" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <InputDir ParameterType="System.String" Required="true" />
      <OutputFile ParameterType="System.String" Required="true" />
      <RootNamespace ParameterType="System.String" Required="true" />
      <Modules ParameterType="System.String" Required="false" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs"><![CDATA[
var spvFiles = Directory.GetFiles(InputDir, "*.spv").OrderBy(p => p, StringComparer.OrdinalIgnoreCase).ToArray();
var wanted = (Modules ?? string.Empty)
    .Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries)
    .Select(s => s.Trim())
    .ToList();
if (wanted.Count > 0)
{
    spvFiles = spvFiles.Where(p => wanted.Contains(Path.GetFileNameWithoutExtension(p), StringComparer.OrdinalIgnoreCase)).ToArray();
}
if (spvFiles.Length == 0)
{
    throw new InvalidOperationException(wanted.Count > 0
        ? "No .spv files matching VulkanShaderModules (" + Modules + ") found in " + InputDir
        : "No .spv files found in " + InputDir);
}

var sb = new StringBuilder();
sb.AppendLine("// <auto-generated>");
sb.AppendLine("// Generated by the GenerateVulkanShaderByteArrays MSBuild target from precompiled SPIR-V (.spv). Do not edit.");
sb.AppendLine("// Runtime: zero reflection, zero Assembly resource access. NativeAOT / trim safe.");
sb.AppendLine("// Regenerate: recompile .vert/.frag to .spv via glslang, then the MSBuild target runs this at build time.");
sb.AppendLine("// </auto-generated>");
sb.AppendLine("namespace " + RootNamespace + ";");
sb.AppendLine();
sb.AppendLine("internal static class EmbeddedShaders");
sb.AppendLine("{");

long totalBytes = 0;
foreach (var file in spvFiles)
{
    var ident = new string(Path.GetFileNameWithoutExtension(file).Select(c => (char.IsLetterOrDigit(c) && c <= 0x7F) ? c : '_').ToArray());
    if (ident.Length == 0 || char.IsDigit(ident[0]))
    {
        ident = "_" + ident;
    }

    var bytes = File.ReadAllBytes(file);
    // SPIR-V magic = 0x07230203 (little-endian file layout: 03 02 23 07). Reject non-SPIR-V input early
    // so a corrupt or stale file fails the build with a clear message instead of embedding garbage.
    if (bytes.Length < 4 || bytes[0] != 0x03 || bytes[1] != 0x02 || bytes[2] != 0x23 || bytes[3] != 0x07)
    {
        throw new InvalidOperationException(Path.GetFileName(file) + " is not a valid SPIR-V module (bad magic number). Recompile from GLSL via 'glslang -V'.");
    }

    totalBytes += bytes.Length;
    sb.AppendLine("    /// <summary>Precompiled SPIR-V module: " + Path.GetFileName(file) + " (" + bytes.Length + " bytes).</summary>");
    sb.AppendLine("    internal static readonly byte[] " + ident + " = new byte[]");
    sb.AppendLine("    {");
    for (int i = 0; i < bytes.Length; i += 16)
    {
        int end = Math.Min(i + 15, bytes.Length - 1);
        var hex = new List<string>(end - i + 1);
        for (int j = i; j <= end; j++)
        {
            hex.Add("0x" + bytes[j].ToString("X2"));
        }
        sb.AppendLine("        " + string.Join(", ", hex) + ",");
    }
    sb.AppendLine("    };");
    sb.AppendLine();
}

sb.AppendLine("}");

var fullOutput = Path.GetFullPath(OutputFile);
var outDir = Path.GetDirectoryName(fullOutput);
if (!string.IsNullOrEmpty(outDir))
{
    Directory.CreateDirectory(outDir);
}
File.WriteAllText(fullOutput, sb.ToString(), new UTF8Encoding(false));
Log.LogMessage(Microsoft.Build.Framework.MessageImportance.Low, "[GEN-SHADERS] Generated {0} ({1} SPIR-V module(s), {2} bytes total)", fullOutput, spvFiles.Length, totalBytes);
]]></Code>
    </Task>
  </UsingTask>

  <!-- SPIR-V → C# 字节数组自动生成（BeforeTargets=CoreCompile 确保在编译前就绪）。
       可选：若 glslang 可用，则重新编译 yuv 着色器对的 .spv（最佳努力，缺失不阻断构建，
       回退用仓库已提交的 .spv）；候选均为 Windows 路径，Linux 构建自动跳过该步。
       并行安全：Renderers.Vulkan 依赖 GPUShare.Vulkan，两工程的该 target 不会并发写同一 .spv。 -->
  <Target Name="GenerateVulkanShaderByteArrays" BeforeTargets="CoreCompile" Inputs="@(_VulkanShaderSource)" Outputs="$(IntermediateOutputPath)Shaders.g.cs">
    <PropertyGroup>
      <_GlslangExe Condition="Exists('$(VULKAN_SDK)\Bin\glslangValidator.exe')">$(VULKAN_SDK)\Bin\glslangValidator.exe</_GlslangExe>
      <_GlslangExe Condition="'$(_GlslangExe)' == '' And Exists('$(MSBuildProjectDirectory)\..\..\..\..\Tools\glslang\bin\glslang.exe')">$(MSBuildProjectDirectory)\..\..\..\..\Tools\glslang\bin\glslang.exe</_GlslangExe>
      <_GlslangExe Condition="'$(_GlslangExe)' == '' And Exists('E:\Tools\glslang\bin\glslang.exe')">E:\Tools\glslang\bin\glslang.exe</_GlslangExe>
    </PropertyGroup>
    <Exec Condition="'$(_GlslangExe)' != ''" Command="&quot;$(_GlslangExe)&quot; -V &quot;$(_VulkanShaderDir)\yuv.vert&quot; -o &quot;$(_VulkanShaderDir)\yuv.vert.spv&quot; &amp; &quot;$(_GlslangExe)&quot; -V &quot;$(_VulkanShaderDir)\yuv.frag&quot; -o &quot;$(_VulkanShaderDir)\yuv.frag.spv&quot;" ContinueOnError="true" StandardOutputImportance="low" />

    <GenerateVulkanShaderBytes InputDir="$(_VulkanShaderDir)" OutputFile="$(IntermediateOutputPath)Shaders.g.cs" RootNamespace="$(RootNamespace)" Modules="$(VulkanShaderModules)" />
  </Target>

</Project>
