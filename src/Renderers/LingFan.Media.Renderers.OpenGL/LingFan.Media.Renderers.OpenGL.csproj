<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 零反射原生绑定（GLNative）使用 unsafe 上下文 + [LibraryImport]，必须开启。 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- 与 D3D11 / Vulkan 渲染器对齐：作为可发布 NuGet 库。
         打包元数据（README/图标/LICENSE/第三方声明）由仓库根 Directory.Build.props 统一注入。 -->
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- AOT 发布须保留 Vortice / SharpGen 原生封送根（对齐 D3D11 / Vulkan 渲染器；dotnet build 不受影响） -->
    <TrimmerRootAssembly Include="Vortice.Direct3D11" />
    <TrimmerRootAssembly Include="Vortice.DXGI" />
    <TrimmerRootAssembly Include="SharpGen.Runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Infrastructure\LingFan.Media.Abstractions\LingFan.Media.Abstractions.csproj" />
    <ProjectReference Include="..\..\Infrastructure\LingFan.Media.Extensions\LingFan.Media.Extensions.csproj" />
    <ProjectReference Include="..\LingFan.Media.Renderers.Shared\LingFan.Media.Renderers.Shared.csproj" />
    <!-- 零拷贝桥接 D3D11 设备创建：与 ffmpeg 解码器同源（FindPreferredAdapter + D3D11CreateDeviceOnAdapter，独显优先），
         保证桥接设备与解码设备在同一张 GPU（双卡跨 GPU 时 OpenSharedResource1 必失败，2026-08-20 真机实证）。 -->
    <ProjectReference Include="..\..\GPUShare\LingFan.Media.GPUShare.D3D11\LingFan.Media.GPUShare.D3D11.csproj" />
  </ItemGroup>

</Project>
