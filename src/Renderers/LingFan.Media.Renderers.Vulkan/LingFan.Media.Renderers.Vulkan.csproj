<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<IsPackable>true</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<!-- ILogger/ILoggerFactory 为本项目直接使用的类型，必须显式声明，
         不能依赖 Extensions 的传递依赖（重构 Extensions 时会编译断裂） -->
		<PackageReference Include="Silk.NET.Vulkan" Version="2.23.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Infrastructure\LingFan.Media.Abstractions\LingFan.Media.Abstractions.csproj" />
		<ProjectReference Include="..\..\Infrastructure\LingFan.Media.Extensions\LingFan.Media.Extensions.csproj" />
		<ProjectReference Include="..\LingFan.Media.Renderers.Shared\LingFan.Media.Renderers.Shared.csproj" />
		<!-- 共享 Vulkan 原生绑定（渲染 + B4 硬解共用，单一零反射 AOT 友好层） -->
		<ProjectReference Include="..\..\GPUShare\LingFan.Media.GPUShare.Vulkan\LingFan.Media.GPUShare.Vulkan.csproj" />
		<!-- 零拷贝跨 GPU 对齐：取默认 D3D11 适配器 LUID（D3D11AdapterLuid，中性互操作模块；
		     单向消费，无环）。仅 Windows 下 EnsureDeviceCreated 调用，非 Windows 不触发。 -->
		<ProjectReference Include="..\..\GPUShare\LingFan.Media.GPUShare.D3D11\LingFan.Media.GPUShare.D3D11.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- GLSL 源与预编译 SPIR-V 唯一真源在 Targets/Vulkan/Shaders/（与 GPUShare.Vulkan 共用）；
		     此处仅以 Link 形式挂入解决方案浏览器便于查看，不复制文件。经共享 target 生成
		     Shaders.g.cs（byte[] 字面量）编译进程序集，运行时零反射；shader 文件不进 NuGet 包。 -->
		<None Include="..\..\..\Targets\Vulkan\Shaders\*.vert;..\..\..\Targets\Vulkan\Shaders\*.frag;..\..\..\Targets\Vulkan\Shaders\*.spv" LinkBase="Shaders" />
		<Compile Remove="obj\Debug\net10.0\Shaders.g.cs" />
		<!-- 生成的字节数组源参与编译，编译进程序集（进 NuGet 包），下游消费者无需重跑任何工具。 -->
		<Compile Include="$(IntermediateOutputPath)Shaders.g.cs" />
	</ItemGroup>

	<PropertyGroup>
		<!-- 模块映射：本渲染管线只使用 yuv 着色器对（共享目录还含 GPUShare 转换器所需的
		     ycbcr/rgba_passthrough），留空则嵌入共享目录全部模块。 -->
		<VulkanShaderModules>yuv.vert;yuv.frag</VulkanShaderModules>
	</PropertyGroup>

	<!-- SPIR-V → C# 字节数组生成 target 在共享 Targets/Vulkan/VulkanShaderBytes.targets（跨平台 MSBuild 内联任务，
	     不依赖 PowerShell，Windows/Linux/macOS 均可构建）；增量与 glslang 可选重编逻辑同在该文件。 -->
	<Import Project="$(MSBuildThisFileDirectory)..\..\..\Targets\Vulkan\VulkanShaderBytes.targets" />

</Project>
