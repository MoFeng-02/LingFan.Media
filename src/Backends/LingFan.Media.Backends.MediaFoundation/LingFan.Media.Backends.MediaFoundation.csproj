<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- MediaFoundation 仅 Windows 可用，程序集级标注使所有代码默认 Windows-only -->
    <SupportedOSPlatform>windows</SupportedOSPlatform>
    <!-- MFVideoDecoder：Lock 指针拷贝 + MFT_OUTPUT_DATA_BUFFER 栈上取址需要 unsafe -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Infrastructure\LingFan.Media.Abstractions\LingFan.Media.Abstractions.csproj" />
    <ProjectReference Include="..\..\Infrastructure\LingFan.Media.Extensions\LingFan.Media.Extensions.csproj" />
    <!-- MfD3D11TextureResource.ReadbackToCpu：MF DXVA 硬解纹理 CPU 回读（NV12→BGRA），
         供 Skia 软渲染兜底路径消费（保持 GPU 解码，打通控件内 WriteableBitmap 上屏）。 -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- NativeCallGate 等内部类型需由本测试工程直接单元测试 -->
    <InternalsVisibleTo Include="LingFan.Media.Backends.MediaFoundation.Tests" />
  </ItemGroup>

</Project>
