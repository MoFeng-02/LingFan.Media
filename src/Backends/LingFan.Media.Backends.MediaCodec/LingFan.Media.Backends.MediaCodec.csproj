<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- 本后端是 100% Android 平台特化（依赖 net-android 的 Android.Media 托管 API），不再提供可移植桩。
        共享层（如 AvaloniaTools net10.0 工程）不引用本后端；由 net10.0-android 入口工程经
        Extensions 的平台注册钩子（MediaBuilderPlatformRegistrar）手动注入，避免跨 TFM 传递解析落到桩实现。 -->
		<TargetFramework>net10.0-android</TargetFramework>
		<!-- 帧 buffer 拷贝 + 原生互操作需要 unsafe -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<IsPackable>true</IsPackable>
		<SupportedOSPlatform>android</SupportedOSPlatform>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Infrastructure\LingFan.Media.Abstractions\LingFan.Media.Abstractions.csproj" />
		<ProjectReference Include="..\..\Infrastructure\LingFan.Media.Extensions\LingFan.Media.Extensions.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- 内部类型供本工程单元测试直接访问 -->
		<InternalsVisibleTo Include="LingFan.Media.Backends.MediaCodec.Tests" />
	</ItemGroup>

</Project>