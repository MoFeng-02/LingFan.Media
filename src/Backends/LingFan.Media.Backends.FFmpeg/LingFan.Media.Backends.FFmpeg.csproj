<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- D3D11HardwareFrameResource.ReadbackToCpu：GPU 硬解纹理 CPU 回读（NV12→BGRA），
         供 Skia 软渲染兜底路径消费。此前因 Backends.FFmpeg 无 Vortice 依赖而未实现，
         现补齐以打通「GPU 解码 + 控件内 WriteableBitmap 上屏」链路（仍保持 GPU 解码，不退回软解）。 -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Infrastructure\LingFan.Media.Abstractions\LingFan.Media.Abstractions.csproj" />
    <ProjectReference Include="..\..\Infrastructure\LingFan.Media.Extensions\LingFan.Media.Extensions.csproj" />
    <!-- 解码侧 D3D11 原生互操作（NV12→RGBA 视频处理器、共享句柄）：中性模块，仅依赖 Abstractions + Vortice -->
    <ProjectReference Include="..\..\GPUShare\LingFan.Media.GPUShare.D3D11\LingFan.Media.GPUShare.D3D11.csproj" />
  </ItemGroup>

</Project>
