<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WasapiSineProbe</RootNamespace>
    <AssemblyName>WasapiSineProbe</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- WASAPI 为 Windows-only API：非 windows TFM 上调用触发 CA1416，与其它探针工程一致地抑制。 -->
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- 刻意「只引音频输出链路」：不引 MediaFoundation / Sources / Consumers，
         从工程引用层面就保证「本探针不可能牵扯解码」，使阴性结果具备排除力。 -->
    <ProjectReference Include="..\..\Infrastructure\LingFan.Media.Extensions\LingFan.Media.Extensions.csproj" />
    <ProjectReference Include="..\..\Outputs\LingFan.Media.Outputs\LingFan.Media.Outputs.csproj" />
  </ItemGroup>

</Project>
