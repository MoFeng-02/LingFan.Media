<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VlcNativePlaybackProbe</RootNamespace>
    <AssemblyName>VlcNativePlaybackProbe</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- 3.1 最小探针：仅验证自写 Apache-2.0 P/Invoke 能 libvlc_new 并打出 3.0.23.1。
         原生 libvlc 运行时由 VideoLAN.LibVLC.Windows 随探针输出自带（LGPL，仅探针携带，不污染库本体）。 -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.10" />
    <!-- 控制台日志 provider：探针是诊断型 exe，需把库内 ILogger 诊断（含 codec 原始值）打到控制台。 -->
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.10" />
    <!-- ServiceCollection / BuildServiceProvider（DI 容器，用于构造 VLCNativeDemuxer 验证端到端） -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <!-- 原生 libvlc 运行时分发包（LGPL）。仅探针携带，用于验证；库本体不含原生运行时。 -->
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Backends\Vlc\LingFan.Media.Backends.VLCNative\LingFan.Media.Backends.VLCNative.csproj" />
    <!-- 文件型 IMediaStream（地址式打开本地样本，验证 demuxer 取帧） -->
    <ProjectReference Include="..\..\Infrastructure\LingFan.Media.Sources\LingFan.Media.Sources.csproj" />
  </ItemGroup>

  <!-- 样本视频复制到输出目录，供 demuxer 播放验证 -->
  <ItemGroup>
    <Content Include="..\..\..\Resources\Video\m1.mp4" CopyToOutputDirectory="PreserveNewest" Link="m1.mp4" />
  </ItemGroup>

</Project>
