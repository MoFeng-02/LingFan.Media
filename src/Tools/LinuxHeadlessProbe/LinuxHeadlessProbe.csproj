<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LinuxHeadlessProbe</RootNamespace>
    <AssemblyName>LinuxHeadlessProbe</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- FFmpeg 后端经自写原生绑定（[LibraryImport] + NativeLibrary 版本自适应加载）调用原生库；
         D3D11VA 硬件加速与 GPUShare.D3D11 为 Windows-only：抑制 CA1416。 -->
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- 跨平台后端/渲染/消费链：ffmpeg 解码 + 无头 NoOp 渲染 + 静音输出。
         全部 net10.0，可在 Linux/WSL2 直接 dotnet run / dotnet publish -r linux-x64。 -->
    <ProjectReference Include="..\..\Backends\LingFan.Media.Backends.FFmpeg\LingFan.Media.Backends.FFmpeg.csproj" />
    <ProjectReference Include="..\..\Infrastructure\LingFan.Media.Sources\LingFan.Media.Sources.csproj" />
    <ProjectReference Include="..\..\Infrastructure\LingFan.Media.Consumers\LingFan.Media.Consumers.csproj" />
    <ProjectReference Include="..\..\Infrastructure\LingFan.Media.Extensions\LingFan.Media.Extensions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 真实媒体资源（与测试工程同源），默认参数 file 指向 Resources/Video/m1.mp4 -->
    <None Include="..\..\..\Resources\**\*" LinkBase="Resources\" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    ffmpeg 原生库（Linux）：不走 Windows 的 CopyFFmpegNative(.dll) 逻辑。
    Linux 下自写 FF 加载器按 lib{name}.so.{ver} 名称 dlopen（如 libavutil.so.60），
    BtbN lgpl-shared 构建已直接提供这些文件。
    运行时优先由下方 CopyFFmpegNativeLinux 在 Linux 构建期把 ThirdParty 的 lib/*.so* 复制到输出目录
    （与 Windows 探针对齐：bin 内直接可用，免环境变量）；备选方案是环境变量
    LF_FFMPEG_LIB 指向 BtbN 的 lib/ 目录，并在运行环境 export LD_LIBRARY_PATH=$LF_FFMPEG_LIB
    以保证依赖链 dlopen 可见。自写 FF 加载器按带版本名优先探测，无版本名兜底。
  -->

  <!-- ffmpeg 原生库（Linux）：复制全部名字层级（libX.so / libX.so.62 / libX.so.62.x.y）——
       无版本名供默认探测，带 soname 名供依赖链解析；BtbN 构建自带 DT_RUNPATH=$ORIGIN，
       bin 内即可依赖闭环。MSBuild Copy 在 Linux 上将符号链接解引用为真实文件，每个名字都是完整 ELF。
       默认取 n8.1（avutil 60，与自绑定结构镜像校准版本一致）；改用其他构建时调整通配符。 -->
  <ItemGroup Condition="'$([MSBuild]::IsOSPlatform(Linux))'">
    <None Include="$(MSBuildProjectDirectory)\..\..\..\ThirdParty\ffmpeg\*n8.1*linux64*\lib\*.so*" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyFFmpegNativeLinux" AfterTargets="Build;Publish" Condition="'$([MSBuild]::IsOSPlatform(Linux))'">
    <ItemGroup>
      <FFmpegSo Include="$(MSBuildProjectDirectory)\..\..\..\ThirdParty\ffmpeg\*n8.1*linux64*\lib\*.so*" />
    </ItemGroup>
    <Message Condition="'@(FFmpegSo)' == ''" Text="[FFMPEG] 未找到 ThirdParty/ffmpeg/*n8.1*linux64*/lib/*.so*，请在 Linux 侧解包 ThirdParty/ffmpeg/ffmpeg-n8.1-latest-linux64-lgpl-shared-8.1.tar.xz，或设置环境变量 LF_FFMPEG_LIB 指向已解包的 lib 目录。" Importance="high" />
  </Target>

</Project>
