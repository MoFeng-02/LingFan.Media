<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>VlcHeadfulPlaybackProbe</RootNamespace>
		<AssemblyName>VlcHeadfulPlaybackProbe</AssemblyName>
		<IsPackable>false</IsPackable>
		<!-- VLC 后端经自写 Apache-2.0 P/Invoke（LingFan.Media.Backends.VLCNative）驱动 VLC 引擎（零 LGPL、AOT 合规）；
		     D3D11 渲染器走 Vortice/SharpGen（Windows-only，抑制 CA1416）；
		     Vortice/SharpGen 经反射构建 COM vtable，NativeAOT 下 trim 标注不全，整族 IL2xxx 均为第三方缺陷；
		     已用 TrimmerRootAssembly 根留这些程序集保证运行时存在，此处仅静默分析器级告警。 -->
		<NoWarn>CA1416;IL2067;IL2070;IL2072;IL2075;IL2080;IL2087;IL2091</NoWarn>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<PublishAot>true</PublishAot>
	</PropertyGroup>

	<!-- Vortice.Direct3D11 (= SharpGen.Runtime) 经反射构建 COM vtable，NativeAOT 下 trim 标注不完整会触发
	     IL2067/IL2072（被 Directory.Build.props 的 TreatWarningsAsErrors 提升为 error）。该库本身 AOT 运行时兼容，
	     属第三方标注缺陷，非本库问题。做法（Vortice + NativeAOT 已知配方）：
	     ① 根留 SharpGen.Runtime / Vortice.*，防运行时反射读取 vtable 成员被裁掉（否则 MissingMethodException）；
	     ② 抑制该第三方库的 trim 分析告警。本库自有 COM 互操作走手搓 vtable P/Invoke 且标注合规，不会触发 IL2xxx。 -->
	<ItemGroup>
		<TrimmerRootAssembly Include="SharpGen.Runtime" />
		<TrimmerRootAssembly Include="Vortice.Direct3D11" />
		<TrimmerRootAssembly Include="Vortice.DXGI" />
		<TrimmerRootAssembly Include="Vortice.D3DCompiler" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
		<PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
		<!-- 原生 libvlc 运行时分发包（LGPL）。仅探针携带，用于独立分发；库本体不含原生运行时。 -->
		<PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />
	</ItemGroup>

	<ItemGroup>
		<!-- 有头全链路：VLC 后端（解封装+解码经 SetVideoCallbacks 内存捕获 BGRA32 帧） + D3D11 上屏（渲染器） + WASAPI 出声（输出）。 -->
		<!-- VLC 帧为 BGRA32 软件帧，D3D11Renderer 上传纹理上屏（VLC 无零拷贝路径，与 ffmpeg D3D11VA 零拷贝不同）。 -->
		<ProjectReference Include="..\..\Renderers\LingFan.Media.Renderers.D3D11\LingFan.Media.Renderers.D3D11.csproj" />
		<ProjectReference Include="..\..\Infrastructure\LingFan.Media.Sources\LingFan.Media.Sources.csproj" />
		<ProjectReference Include="..\..\Infrastructure\LingFan.Media.Consumers\LingFan.Media.Consumers.csproj" />
		<ProjectReference Include="..\..\Infrastructure\LingFan.Media.Extensions\LingFan.Media.Extensions.csproj" />
		<ProjectReference Include="..\..\Outputs\LingFan.Media.Outputs\LingFan.Media.Outputs.csproj" />
		<!-- VLC 后端（自写 Apache-2.0 P/Invoke，零 LGPL）：解封装+解码经 SetVideoCallbacks 内存捕获 BGRA32 帧。 -->
		<ProjectReference Include="..\..\Backends\LingFan.Media.Backends.VLCNative\LingFan.Media.Backends.VLCNative.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- 真实媒体资源（与其它探针同源） -->
		<None Include="..\..\..\Resources\**\*" LinkBase="Resources\" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
