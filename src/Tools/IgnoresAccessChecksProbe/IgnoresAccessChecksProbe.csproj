<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- 探针专用：验证 IgnoresAccessChecksTo 在 PublishAot 下的可用性，不代表库项目宪法放宽 -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- 直接引用本地 NuGet 缓存里的 Avalonia 12.1.1 组件（探针不进解决方案分发物） -->
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Avalonia.Base">
      <HintPath>E:/Nuget/nuget/.nuget/packages/avalonia/12.1.1/lib/net8.0\Avalonia.Base.dll</HintPath>
    </Reference>
    <Reference Include="Avalonia.Vulkan">
      <HintPath>E:/Nuget/nuget/.nuget/packages/avalonia/12.1.1/lib/net8.0\Avalonia.Vulkan.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
