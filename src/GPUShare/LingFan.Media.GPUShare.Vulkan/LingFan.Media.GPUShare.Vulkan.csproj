<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- 中性 Vulkan 原生绑定（自建零反射 AOT 友好层，复用 Silk.NET 纯数据定义）；仅作数据类型复用，不依赖其运行时绑定。 -->
    <PackageReference Include="Silk.NET.Vulkan" Version="2.23.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Infrastructure\LingFan.Media.Abstractions\LingFan.Media.Abstractions.csproj" />
    <ProjectReference Include="..\LingFan.Media.GPUShare.Android\LingFan.Media.GPUShare.Android.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- GLSL 源与预编译 SPIR-V 唯一真源在 Targets/Vulkan/Shaders/（与 Renderers.Vulkan 共用）；
         此处仅以 Link 形式挂入解决方案浏览器便于查看，不复制文件。经共享 target 生成
         Shaders.g.cs（byte[] 字面量）编译进程序集，运行时零反射；shader 文件不进 NuGet 包。 -->
    <None Include="..\..\..\Targets\Vulkan\Shaders\*.vert;..\..\..\Targets\Vulkan\Shaders\*.frag;..\..\..\Targets\Vulkan\Shaders\*.spv" LinkBase="Shaders" />
    <Compile Remove="obj\Debug\net10.0\Shaders.g.cs" />
    <!-- 生成的字节数组源参与编译，编译进程序集（进 NuGet 包），下游消费者无需重跑任何工具。 -->
    <Compile Include="$(IntermediateOutputPath)Shaders.g.cs" />
  </ItemGroup>

  <!-- SPIR-V → C# 字节数组生成 target 在共享 Targets/Vulkan/VulkanShaderBytes.targets（跨平台 MSBuild 内联任务，
       不依赖 PowerShell，Windows/Linux/macOS 均可构建）；增量与 glslang 可选重编逻辑同在该文件。 -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\..\Targets\Vulkan\VulkanShaderBytes.targets" />

</Project>
