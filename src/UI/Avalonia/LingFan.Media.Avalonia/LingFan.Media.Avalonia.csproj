<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<IsPackable>true</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.1.1" />
		<!-- GPU 直绘路径需要 ISkiaSharpApiLeaseFeature（public, [Unstable]）。
		     SkiaSharp 经此包传递引用（3.119.4，与 Avalonia.Skia nuspec 依赖精确一致），
		     本工程绝不单独 PackageReference SkiaSharp，避免版本分叉。 -->
		<PackageReference Include="Avalonia.Skia" Version="12.1.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\..\Infrastructure\LingFan.Media.Abstractions\LingFan.Media.Abstractions.csproj" />
		<ProjectReference Include="..\..\..\Infrastructure\LingFan.Media.Extensions\LingFan.Media.Extensions.csproj" />
		<ProjectReference Include="..\..\..\Presenters\LingFan.Media.GpuPresenter\LingFan.Media.GpuPresenter.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- 允许测试项目访问 internal 转换逻辑（YUV→BGRA 等）以做单元测试 -->
		<InternalsVisibleTo Include="LingFan.Media.Avalonia.Tests" />
	</ItemGroup>

	<ItemGroup>
		<AvaloniaXaml Include="Assets\**\*.axaml" />
	</ItemGroup>

</Project>
